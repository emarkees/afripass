pragma language_version >= 0.17.0;

import CompactStandardLibrary;

// PUBLIC LEDGER STATE:
// A public counter tracking the total number of unique verified claims.
export ledger total_verified: Uint<32>;

constructor() {
    total_verified = 0;
}

// PRIVATE WITNESS (CIRCUIT INPUT):
// - user_pubkey_witness: The public key (passed as a witness so it can be disclosed)
// - income: The user's actual private monthly income.
export circuit verify_eligibility(user_pubkey_witness: Bytes<32>, income: Uint<32>): [] {
    // 1. ZK Proof: Assert the user's private income meets the minimum requirement.
    // The specific income is NEVER disclosed, only the proof that it passed this check.
    assert(income >= 350000, "Income does not meet the minimum eligibility requirement");

    // 2. Increment the total verified counter
    // For this specific build, we keep it simple without Map to ensure compatibility 
    // across all Compact compiler versions. The user identity is proven off-chain.
    total_verified = (total_verified + 1) as Uint<32>;
}
