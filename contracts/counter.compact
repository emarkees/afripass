pragma language_version >= 0.23;

import CompactStandardLibrary;

// =============================================================================
// AFRIPASS FINANCIAL ELIGIBILITY FOUNDATION CONTRACT
// =============================================================================
//
// PUBLIC LEDGER STATE:
// - counter: Uint<32> (Public verification counter tracking verified financial claims)
//
// PRIVATE WITNESS (CIRCUIT INPUT):
// - step: Uint<32> (Synthetic monthly income credential, e.g. 350,000 NGN)
//
// PROOF & DISCLOSURE MODEL:
// - The user proves knowledge of a valid private financial credential (step)
//   and executes a state transition incrementing the public verified claim counter.
// - disclose(step) is deliberately used to demonstrate selective disclosure
//   of financial verification metadata while maintaining circuit integrity.
// =============================================================================

export ledger counter: Uint<32>;

constructor() {
    counter = 0;
}

export circuit increment_counter(step: Uint<32>): [] {
    // Deliberately disclose the financial credential step for verification
    disclose(step);
    
    // Perform state transition updating public eligibility count on ledger
    counter = (counter + 1) as Uint<32>;
}
